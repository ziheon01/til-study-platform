// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TilCategory {
  CS
  ALGORITHM
  BACKEND
  FRONTEND
  ETC
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  nickname  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tils          Til[]
  tasks         Task[]
  streak        Streak?
  refreshTokens RefreshToken[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Til {
  id        String      @id @default(uuid())
  userId    String
  date      DateTime    @db.Date
  title     String
  content   String
  category  TilCategory @default(ETC)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
  @@map("tils")
}

model Task {
  id          String   @id @default(uuid())
  userId      String
  date        DateTime @db.Date
  title       String
  isCompleted Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@map("tasks")
}

model Streak {
  id            String    @id @default(uuid())
  userId        String    @unique
  currentStreak Int       @default(0)
  longestStreak Int       @default(0)
  lastStudiedAt DateTime? @db.Date
  updatedAt     DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("streaks")
}